	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^24.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"verify": "pnpm lint && pnpm check && pnpm test && pnpm build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "node --test tests/*.test.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.39.1",
		"@sveltejs/adapter-node": "5.5.8",
		"@sveltejs/kit": "2.5.28",
		"@sveltejs/vite-plugin-svelte": "^3.1.2",
		"@types/node": "^22",
		"bits-ui": "0.22.0",
		"clsx": "^2.1.1",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.13.0",
		"globals": "^16.5.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^4.2.19",
		"svelte-check": "^3.8.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.47.0",
		"vite": "^5.4.11"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"allowScripts": {
		"esbuild@0.21.5": true,
		"svelte-preprocess@5.1.4": true
	},
	"dependencies": {
		"zod": "^4.6.7"
	}
}
